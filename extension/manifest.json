{
  "manifest_version": 3,
  "name": "TruthLens AI",
  "short_name": "TruthLens",
  "version": "0.1.0",
  "description": "Real-time deepfake detection overlay for video calls. Prototype – uses mock inference only.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TruthLens AI",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/logger.js",
        "overlay/overlay.js",
        "content/content.js"
      ],
      "css": ["overlay/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],

  "host_permissions": [],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "web_accessible_resources": [
    {
      "resources": ["overlay/overlay.css", "icons/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["detector/detector.html", "lib/*", "lib/wasm/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
